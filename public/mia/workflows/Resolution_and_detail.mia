It's all about the pixels&lt;/div&gt;&lt;div class=&quot;mb-2&quot;&gt;Pictures are made of squares called pixels.&lt;/div&gt;&lt;div class=&quot;mb-2&quot;&gt;The more pixels a picture has, the more detail we can see.  This is called resolution.&lt;/div&gt;&lt;div class=&quot;mb-4&quot;&gt;Pictures with high resolution look sharp and clear, while low-resolution pictures can look blocky or blurry.&lt;/div&gt;" VISIBLE="false"/></PARAMS></COLLECTION></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.system.GUISeparator" DISABLEABLE="false" ENABLED="true" ID="1277406340" NAME="GUI separator" NICKNAME="Activity" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Show in processing view" NICKNAME="Show in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAMETER NAME="Expanded in processing view" NICKNAME="Expanded in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAMETER NAME="Expanded in editing view" NICKNAME="Expanded in editing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.DisplaySimpleImage" DISABLEABLE="false" ENABLED="true" ID="41293988" NAME="Display simple image" NICKNAME="Display simple image" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Add image" NICKNAME="Add image" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Image name" NICKNAME="Image name" SHOW_TEXT="false" VALUE="Intro" VISIBLE="false"/></PARAMS></COLLECTION></PARAMETER><PARAMETER NAME="Show probe control" NICKNAME="Show probe control" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Show select control" NICKNAME="Show select control" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Show zoom control" NICKNAME="Show zoom control" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Default control" NICKNAME="Default control" SHOW_TEXT="false" VALUE="Move" VISIBLE="false"/><PARAMETER NAME="About text" NICKNAME="About text" VALUE="A cartoon" VISIBLE="false"/></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.CreateMessage" DISABLEABLE="false" ENABLED="true" ID="1730596231" NAME="Create message" NICKNAME="Create message" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Add output" NICKNAME="Add output" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Output type" NICKNAME="Output type" SHOW_TEXT="false" VALUE="Text" VISIBLE="false"/><PARAM NAME="Graph to display" NICKNAME="Graph to display" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Module" NICKNAME="Module" VALUE="" VISIBLE="false"/><PARAM NAME="Parameter to display" NICKNAME="Parameter to display" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Text to display" NICKNAME="Text to display" VALUE="&lt;div class=&quot;text-emerald-500 italic text-4xl mb-4&quot;&gt;The aim of the game&lt;/div&gt;&lt;div class=&quot;mb-2&quot;&gt;On the next page, you'll see a low-resolution picture that only uses a few pixels.&lt;/div&gt;&lt;div class=&quot;mb-2&quot;&gt;Try to guess what the picture shows and type your answer in the box.  If your guess isn't right, the resolution will increase, making the picture clearer.&lt;/div&gt;&lt;div class=&quot;mb-2&quot;&gt;Each right answer will win you a star!&lt;/div&gt;" VISIBLE="false"/></PARAMS></COLLECTION></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.system.GUISeparator" DISABLEABLE="false" ENABLED="true" ID="2059975333" NAME="GUI separator" NICKNAME="Shell" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Show in processing view" NICKNAME="Show in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAMETER NAME="Expanded in processing view" NICKNAME="Expanded in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAMETER NAME="Expanded in editing view" NICKNAME="Expanded in editing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.system.GlobalVariables" DISABLEABLE="false" ENABLED="true" ID="449335296" NAME="Global variables" NICKNAME="Global variables" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Add new variable" NICKNAME="Add new variable" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Variable name" NICKNAME="Variable name" VALUE="GUESS" VISIBLE="false"/><PARAM NAME="Variable type" NICKNAME="Variable type" SHOW_TEXT="false" VALUE="Text" VISIBLE="false"/><PARAM NAME="Variable Boolean" NICKNAME="Variable Boolean" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAM NAME="Variable value" NICKNAME="GUESS" VALUE="" VISIBLE="false"/><PARAM NAME="Variable file" NICKNAME="Variable file" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Variable folder" NICKNAME="Variable folder" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Variable choices" NICKNAME="Variable choices" VALUE="" VISIBLE="false"/><PARAM NAME="Variable choice" NICKNAME="Variable choice" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Store as metadata item" NICKNAME="Store as metadata item" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAM NAME="Variable text" NICKNAME="Variable text" VALUE="" VISIBLE="false"/></PARAMS></COLLECTION></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="GUESS" NICKNAME="GUESS"/></METADATA></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.script.RunScript" DISABLEABLE="false" ENABLED="true" ID="906818173" NAME="Run script" NICKNAME="Run script" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.2"><PARAMETERS><PARAMETER NAME="Add output" NICKNAME="Add output" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Output type" NICKNAME="Output type" SHOW_TEXT="false" VALUE="Metadata" VISIBLE="false"/><PARAM NAME="Output image" NICKNAME="Output image" VALUE="" VISIBLE="false"/><PARAM NAME="Output objects" NICKNAME="Output objects" VALUE="" VISIBLE="false"/><PARAM NAME="Associated image" NICKNAME="Associated image" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Metadata name" NICKNAME="Metadata name" VALUE="RESULT" VISIBLE="false"/><PARAM NAME="Associated objects" NICKNAME="Associated objects" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Measurement name" NICKNAME="Measurement name" VALUE="" VISIBLE="false"/><PARAM NAME="Object metadata name" NICKNAME="Object metadata name" VALUE="" VISIBLE="false"/><PARAM NAME="Parent name" NICKNAME="Parent name" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Children name" NICKNAME="Children name" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Partners name 1" NICKNAME="Partners name 1" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Partners name 2" NICKNAME="Partners name 2" SHOW_TEXT="false" VALUE="" VISIBLE="false"/></PARAMS></COLLECTION></PARAMETER><PARAMETER NAME="Script mode" NICKNAME="Script mode" SHOW_TEXT="false" VALUE="Script text" VISIBLE="false"/><PARAMETER NAME="Script language" NICKNAME="Script language" SHOW_TEXT="false" VALUE="Beanshell" VISIBLE="false"/><PARAMETER NAME="Script text" NICKNAME="Script text" VALUE="// The following two parameters will provide references to the workspace and current module.&#10;#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import java.util.Arrays;&#10;import java.util.HashMap;&#10;&#10;import io.github.mianalysis.miaserver.utils.StarCounter;&#10;&#10;import org.apache.commons.text.similarity.LevenshteinDistance;&#10;&#10;maxDistance = 2;&#10;&#10;metadata = workspace.getMetadata();&#10;&#10;// Only do something when a guess has been made&#10;&#10;if (metadata.get(&quot;GUESS&quot;).equals(&quot;&quot;)) {&#10;&#9;metadata.put(&quot;RESULT&quot;,&quot;&quot;);&#10;&#9;return;&#10;}&#10;&#10;levenshtein = new LevenshteinDistance();&#10;bestMatch = null;&#10;bestDistance = Integer.MAX_VALUE;&#10;&#10;for (word:validOptions.split(&quot;,&quot;)) {&#10;    distance = levenshtein.apply(metadata.get(&quot;GUESS&quot;), word);&#10;    if (distance &lt; bestDistance) {&#10;        bestMatch = word;&#10;        bestDistance = distance;&#10;    }&#10;}&#10;&#10;currVal = Integer.parseInt((String) metadata.get(index));&#10;if (bestDistance &lt;= maxDistance) {&#10;&#9;metadata.put(&quot;RESULT&quot;,&quot;That's right!  Have a star!&quot;);&#10;    metadata.put(index,&quot;1&quot;);&#10;&#9;StarCounter.addStar(&quot;Resolution_and_detail&quot;, starName);&#10;} else {&#10;    metadata.put(&quot;RESULT&quot;,&quot;That's a great guess, but try again&quot;);&#10;&#9;metadata.put(index, String.valueOf(--currVal));&#10;}&#10;" VISIBLE="false"/><PARAMETER NAME="Script file" NICKNAME="Script file" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Add parameter" NICKNAME="Add parameter" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Parameter type" NICKNAME="Parameter type" SHOW_TEXT="false" VALUE="Text" VISIBLE="false"/><PARAM NAME="Parameter name" NICKNAME="Parameter name" VALUE="validOptions" VISIBLE="false"/><PARAM NAME="Parameter checkbox" NICKNAME="Parameter checkbox" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAM NAME="Parameter numeric value" NICKNAME="Parameter numeric value" VALUE="0.0" VISIBLE="false"/><PARAM NAME="Parameter text value" NICKNAME="Parameter text value" VALUE="shell,a shell" VISIBLE="false"/></PARAMS><PARAMS><PARAM NAME="Parameter type" NICKNAME="Parameter type" SHOW_TEXT="false" VALUE="Text" VISIBLE="false"/><PARAM NAME="Parameter name" NICKNAME="Parameter name" VALUE="starName" VISIBLE="false"/><PARAM NAME="Parameter checkbox" NICKNAME="Parameter checkbox" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAM NAME="Parameter numeric value" NICKNAME="Parameter numeric value" VALUE="0.0" VISIBLE="false"/><PARAM NAME="Parameter text value" NICKNAME="Parameter text value" VALUE="A" VISIBLE="false"/></PARAMS><PARAMS><PARAM NAME="Parameter type" NICKNAME="Parameter type" SHOW_TEXT="false" VALUE="Text" VISIBLE="false"/><PARAM NAME="Parameter name" NICKNAME="Parameter name" VALUE="index" VISIBLE="false"/><PARAM NAME="Parameter checkbox" NICKNAME="Parameter checkbox" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAM NAME="Parameter numeric value" NICKNAME="Parameter numeric value" VALUE="0.0" VISIBLE="false"/><PARAM NAME="Parameter text value" NICKNAME="Parameter text value" VALUE="SHELL_IDX" VISIBLE="false"/></PARAMS></COLLECTION></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="RESULT" NICKNAME="RESULT"/></METADATA></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.images.transform.ScaleStack" DISABLEABLE="false" ENABLED="true" ID="209195884" NAME="Scale stack" NICKNAME="Scale stack" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Input image" NICKNAME="Input image" SHOW_TEXT="false" VALUE="Shell" VISIBLE="false"/><PARAMETER NAME="Output image" NICKNAME="Output image" VALUE="S_Shell" VISIBLE="false"/><PARAMETER NAME="Interpolation mode" NICKNAME="Interpolation mode" SHOW_TEXT="false" VALUE="None" VISIBLE="false"/><PARAMETER NAME="Scale mode (x-axis)" NICKNAME="Scale mode (x-axis)" SHOW_TEXT="false" VALUE="Scale factor" VISIBLE="false"/><PARAMETER NAME="Resolution (x-axis)" NICKNAME="Resolution (x-axis)" VALUE="1" VISIBLE="false"/><PARAMETER NAME="Image (x-axis)" NICKNAME="Image (x-axis)" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Adopt calibration (x-axis)" NICKNAME="Adopt calibration (x-axis)" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Scale factor (x-axis)" NICKNAME="Scale factor (x-axis)" VALUE="CD{1/(Me{SHELL_IDX}*Me{SHELL_IDX})}" VISIBLE="false"/><PARAMETER NAME="Scale mode (y-axis)" NICKNAME="Scale mode (y-axis)" SHOW_TEXT="false" VALUE="Scale factor" VISIBLE="false"/><PARAMETER NAME="Resolution (y-axis)" NICKNAME="Resolution (y-axis)" VALUE="1" VISIBLE="false"/><PARAMETER NAME="Image (y-axis)" NICKNAME="Image (y-axis)" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Adopt calibration (y-axis)" NICKNAME="Adopt calibration (y-axis)" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Scale factor (y-axis)" NICKNAME="Scale factor (y-axis)" VALUE="CD{1/(Me{SHELL_IDX}*Me{SHELL_IDX})}" VISIBLE="false"/><PARAMETER NAME="Scale mode (z-axis)" NICKNAME="Scale mode (z-axis)" SHOW_TEXT="false" VALUE="Scale factor" VISIBLE="false"/><PARAMETER NAME="Resolution (z-axis)" NICKNAME="Resolution (z-axis)" VALUE="1" VISIBLE="false"/><PARAMETER NAME="Image (z-axis)" NICKNAME="Image (z-axis)" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Adopt calibration (z-axis)" NICKNAME="Adopt calibration (z-axis)" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Scale factor (z-axis)" NICKNAME="Scale factor (z-axis)" VALUE="1.0" VISIBLE="false"/></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.images.transform.ScaleStack" DISABLEABLE="false" ENABLED="true" ID="1067639352" NAME="Scale stack" NICKNAME="Scale stack" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Input image" NICKNAME="Input image" SHOW_TEXT="false" VALUE="