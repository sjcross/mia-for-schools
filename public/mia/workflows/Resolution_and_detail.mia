xt" VALUE="A cartoon" VISIBLE="false"/></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.CreateMessage" DISABLEABLE="false" ENABLED="true" ID="338348656" NAME="Create message" NICKNAME="Create message" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Add output" NICKNAME="Add output" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Output type" NICKNAME="Output type" SHOW_TEXT="false" VALUE="Text" VISIBLE="false"/><PARAM NAME="Graph to display" NICKNAME="Graph to display" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Module" NICKNAME="Module" VALUE="" VISIBLE="false"/><PARAM NAME="Parameter to display" NICKNAME="Parameter to display" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Text to display" NICKNAME="Text to display" VALUE="&lt;div class=&quot;text-emerald-500 italic text-4xl mb-4&quot;&gt;Time to guess!&lt;/div&gt;&lt;div class=&quot;mb-2&quot;&gt;This image is CI{Im{S_Shell|DIMENSIONS // WIDTH (PX)}} pixels wide and CI{Im{S_Shell|DIMENSIONS // HEIGHT (PX)}} pixels tall.  There are a total of CI{Im{S_Shell|DIMENSIONS // WIDTH (PX)}*Im{S_Shell|DIMENSIONS // HEIGHT (PX)}} pixels.&lt;/div&gt;&lt;div class=&quot;mb-4&quot;&gt;Type what you think this image shows below, then press &quot;Enter&quot;&lt;/div&gt;" VISIBLE="false"/></PARAMS><PARAMS><PARAM NAME="Output type" NICKNAME="Output type" SHOW_TEXT="false" VALUE="Parameter" VISIBLE="false"/><PARAM NAME="Graph to display" NICKNAME="Graph to display" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Module" NICKNAME="Module" VALUE="449335296" VISIBLE="false"/><PARAM NAME="Parameter to display" NICKNAME="Parameter to display" SHOW_TEXT="false" VALUE="Add new variable // Variable value // 1" VISIBLE="false"/><PARAM NAME="Text to display" NICKNAME="Text to display" VALUE="" VISIBLE="false"/></PARAMS><PARAMS><PARAM NAME="Output type" NICKNAME="Outpu