LUE="" VISIBLE="false"/><PARAM NAME="Variable file" NICKNAME="Variable file" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Variable folder" NICKNAME="Variable folder" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Variable choices" NICKNAME="Variable choices" VALUE="" VISIBLE="false"/><PARAM NAME="Variable choice" NICKNAME="Variable choice" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Store as metadata item" NICKNAME="Store as metadata item" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAM NAME="Variable text" NICKNAME="Variable text" VALUE="" VISIBLE="false"/></PARAMS></COLLECTION></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="GUESS" NICKNAME="GUESS"/></METADATA></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.script.RunScript" DISABLEABLE="false" ENABLED="true" ID="1570824891" NAME="Run script" NICKNAME="Run script" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.2"><PARAMETERS><PARAMETER NAME="Add output" NICKNAME="Add output" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Output type" NICKNAME="Output type" SHOW_TEXT="false" VALUE="Metadata" VISIBLE="false"/><PARAM NAME="Output image" NICKNAME="Output image" VALUE="" VISIBLE="false"/><PARAM NAME="Output objects" NICKNAME="Output objects" VALUE="" VISIBLE="false"/><PARAM NAME="Associated image" NICKNAME="Associated image" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Metadata name" NICKNAME="Metadata name" VALUE="RESULT" VISIBLE="false"/><PARAM NAME="Associated objects" NICKNAME="Associated objects" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Measurement name" NICKNAME="Measurement name" VALUE="" VISIBLE="false"/><PARAM NAME="Object metadata name" NICKNAME="Object metadata name" VALUE="" VISIBLE="false"/><PARAM NAME="Parent name" NICKNAME="Parent name" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Children name" NICKNAME="Children name" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Partners name 1" NICKNAME="Partners name 1" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAM NAME="Partners name 2" NICKNAME="Partners name 2" SHOW_TEXT="false" VALUE="" VISIBLE="false"/></PARAMS></COLLECTION></PARAMETER><PARAMETER NAME="Script mode" NICKNAME="Script mode" SHOW_TEXT="false" VALUE="Script text" VISIBLE="false"/><PARAMETER NAME="Script language" NICKNAME="Script language" SHOW_TEXT="false" VALUE="Beanshell" VISIBLE="false"/><PARAMETER NAME="Script text" NICKNAME="Script text" VALUE="// The following two parameters will provide references to the workspace and current module.&#10;#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import java.util.Arrays;&#10;import java.util.HashMap;&#10;&#10;import io.github.mianalysis.miaserver.utils.StarCounter;&#10;&#10;import org.apache.commons.text.similarity.LevenshteinDistance;&#10;&#10;maxDistance = 2;&#10;&#10;metadata = workspace.getMetadata();&#10;&#10;// Only do something when a guess has been made&#10;&#10;if (metadata.get(&quot;GUESS&quot;).equals(&quot;&quot;)) {&#10;&#9;metadata.put(&quot;RESULT&quot;,&quot;&quot;);&#10;&#9;return;&#10;}&#10;&#10;levenshtein = new LevenshteinDistance();&#10;bestMatch = null;&#10;bestDistance = Integer.MAX_VALUE;&#10;&#10;for (word:validOptions.split(&quot;,&quot;)) {&#10;    distance = levenshtein.apply(metadata.get(&quot;GUESS&quot;), word);&#10;    if (distance &lt; bestDistance) {&#10;        bestMatch = word;&#10;        bestDistance = distance;&#10;    }&#10;}&#10;&#10;currVal = Integer.parseInt((String) metadata.get(index));&#10;if (bestDistance &lt;= maxDistance) {&#10;&#9;metadata.put(&quot;RESULT&quot;,&quot;That's right!  Have a star!&quot;);&#10;    metadata.put(index,&quot;1&quot;);&#10;&#9;StarCounter.addStar(&quot;Resolution_and_detail&quot;, starName);&#10;} else {&#10;    metadata.put(&quot;RESULT&quot;,&quot;That's a great guess, but try again&quot;);&#10;&#9;metadata.put(index, String.valueOf(--currVal));&#10;}&#10;" VISIBLE="false"/><PARAMETER NAME="Script file" NICKNAME="Script file" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Add parameter" NICKNAME="Add parameter" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Parameter type" NICKNAME="Parameter type" SHOW_TEXT="false" VALUE="Text" VISIBLE="false"/><PARAM NAME="Parameter name" NICKNAME="Parameter name" VALUE="validOptions" VISIBLE="false"/><PARAM NAME="Parameter checkbox" NICKNAME="Parameter checkbox" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAM NAME="Parameter numeric value" NICKNAME="Parameter numeric value" VALUE="0.0" VISIBLE="false"/><PARAM NAME="Parameter text value" NICKNAME="Parameter text value" VALUE="feather,birds feather" VISIBLE="false"/></PARAMS><PARAMS><PARAM NAME="Parameter type" NICKNAME="Parameter type" SHOW_TEXT="false" VALUE="Text" VISIBLE="false"/><PARAM NAME="Parameter name" NICKNAME="Parameter name" VALUE="starName" VISIBLE="false"/><PARAM NAME="Parameter checkbox" NICKNAME="Parameter checkbox" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAM NAME="Parameter numeric value" NICKNAME="Parameter numeric value" VALUE="0.0" VISIBLE="false"/><PARAM NAME="Parameter text value" NICKNAME="Parameter text value" VALUE="C" VISIBLE="false"/></PARAMS><PARAMS><PARAM NAME="Parameter type" NICKNAME="Parameter type" SHOW_TEXT="false" VALUE="Text" VISIBLE="false"/><PARAM NAME="Parameter name" NICKNAME="Parameter name" VALUE="index" VISIBLE="false"/><PARAM NAME="Parameter checkbox" NICKNAME="Parameter checkbox" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAM NAME="Parameter numeric value" NICKNAME="Parameter numeric value" VALUE="0.0" VISIBLE="false"/><PARAM NAME="Parameter text value" NICKNAME="Parameter text value" VALUE="FEATHER_IDX" VISIBLE="false"/></PARAMS></COLLECTION></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="RESULT" NICKNAME="RESULT"/></METADATA></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.images.transform.ScaleStack" DISABLEABLE="false" ENABLED="true" ID="1269043831" NAME="Scale stack" NICKNAME="Scale stack" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Input image" NICKNAME="Input image" SHOW_TEXT="false" VALUE="Feather" VISIBLE="false"/><PARAMETER NAME="Output image" NICKNAME="Output image" VALUE="S_Feather" VISIBLE="false"/><PARAMETER NAME="Interpolation mode" NICKNAME="Interpolation mode" SHOW_TEXT="false" VALUE="None" VISIBLE="false"/><PARAMETER NAME="Scale mode (x-axis)" NICKNAME="Scale mode (x-axis)" SHOW_TEXT="false" VALUE="Scale factor" VISIBLE="false"/><PARAMETER NAME="Resolution (x-axis)" NICKNAME="Resolution (x-axis)" VALUE="1" VISIBLE="false"/><PARAMETER NAME="Image (x-axis)" NICKNAME="Image (x-axis)" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Adopt calibration (x-axis)" NICKNAME="Adopt calibration (x-axis)" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Scale factor (x-axis)" NICKNAME="Scale factor (x-axis)" VALUE="CD{1/(Me{FEATHER_IDX}*Me{FEATHER_IDX})}" VISIBLE="false"/><PARAMETER NAME="Scale mode (y-axis)" NICKNAME="Scale mode (y-axis)" SHOW_TEXT="false" VALUE="Scale factor" VISIBLE="false"/><PARAMETER NAME="Resolution (y-axis)" NICKNAME="Resolution (y-axis)" VALUE="1" VISIBLE="false"/><PARAMETER NAME="Image (y-axis)" NICKNAME="Image (y-axis)" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Adopt calibration (y-axis)" NICKNAME="Adopt calibration (y-axis)" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Scale factor (y-axis)" NICKNAME="Scale factor (y-axis)" VALUE="CD{1/(Me{FEATHER_IDX}*Me{FEATHER_IDX})}" VISIBLE="false"/><PARAMETER NAME="Scale mode (z-axis)" NICKNAME="Scale mode (z-axis)" SHOW_TEXT="false" VALUE="Scale factor" VISIBLE="false"/><PARAMETER NA